# =============================================================================
# AUDIT-OS WEBAPP — .env.example
# Copia in .env e compila con i valori reali (NON committare .env)
# =============================================================================

# --- Gemini API (solo se chiamate dirette, di norma si usa il proxy) ---
GEMINI_API_KEY=

# --- Gemini Proxy (Cloud Function) ---
GEMINI_PROXY_URL=https://your-region-your-project.cloudfunctions.net/gemini-proxy
GEMINI_PROXY_SECRET=

# --- OCR ---
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\Program Files\poppler\bin
