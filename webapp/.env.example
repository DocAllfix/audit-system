# =============================================================================
# AUDIT-OS WEBAPP — .env.example
# Copia in .env e compila con i valori reali (NON committare .env)
# =============================================================================

# --- Gemini API (solo se chiamate dirette, di norma si usa il proxy) ---
GEMINI_API_KEY=

# --- Gemini Proxy (Cloud Function) ---
GEMINI_PROXY_URL=https://your-region-your-project.cloudfunctions.net/gemini-proxy
GEMINI_PROXY_SECRET=

# --- OCR ---
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\Program Files\poppler\bin

# =============================================================================
# V2 PIPELINE — Provider LLM
# =============================================================================
# Provider attivo per webapp/v2/pipeline.py:
#   gemini-2.5-flash    (default — comportamento PROD attuale)
#   gpt-4.1-mini-azure  (Azure OpenAI Foundry v1, region EU, GDPR-compliant)
V2_PROVIDER=gemini-2.5-flash

# --- Azure OpenAI (richiesto se V2_PROVIDER=gpt-4.1-mini-azure) ---
# Endpoint Foundry v1 (NON Azure OpenAI v1/api-version): la URL deve terminare
# con /openai/v1 e SENZA /chat/completions.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT_GPT_41_MINI=gpt-4.1-mini

# Disabilita il fallback Gemini sui batch Azure che esauriscono i retry 429.
# Default 0 = fallback ATTIVO (recupero automatico). Impostare a 1 per replay
# fedele alle metriche pure di Azure senza copertura Gemini.
V2_DISABLE_FALLBACK=0

# Modalità output pipeline V2:
#   structured  (default) — YAML → incremental docx builder → merge
#   narrative   — Prompt narrativo originale 9 macroaree → JSON array →
#                 _parse_json_narrativo_fallback → generate_structured_evidence_docx
#                 NOTA: attivabile solo con V2_PROVIDER=gpt-4.1-mini-azure
V2_OUTPUT_MODE=structured
